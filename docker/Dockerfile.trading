FROM python:3.10-slim

LABEL maintainer="DSA Trading Bot"
LABEL description="TQQQ 自动交易机器人"

WORKDIR /app

# 安装依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制代码
COPY src/ ./src/
COPY trading_main.py .

# 创建数据目录
RUN mkdir -p /app/logs /app/data /app/config

# 非 root 用户运行
RUN useradd -m -r trader && chown -R trader:trader /app
USER trader

# 健康检查：确认进程在运行
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD python -c "import os; os.path.exists('/app/data/trading_state.json')" || exit 1

ENTRYPOINT ["python", "trading_main.py"]
